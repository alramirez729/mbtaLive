# Optional. Without a key the MBTA API allows 20 requests/minute per IP, which
# the proxy's cache usually stays under. With one the limit rises to 1000/min.
# Free key: https://api-v3.mbta.com/register
MBTA_API_KEY=

# Only needed if the browser and the proxy are on different origins, which is
# not the case on Vercel. Defaults to *.
# CORS_ORIGIN=https://your-app.vercel.app

# Standalone listener port. Render sets this automatically.
# PORT=8081
