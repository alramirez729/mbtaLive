{
  "name": "mbta-live",
  "version": "2.0.0",
  "private": true,
  "description": "Live MBTA rail map and service alerts",
  "workspaces": [
    "frontend",
    "backend/server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:proxy dev:web",
    "dev:web": "npm run dev --workspace @mbtalive/web",
    "dev:proxy": "npm run dev --workspace @mbtalive/proxy",
    "build": "npm run build --workspace @mbtalive/web",
    "preview": "npm run preview --workspace @mbtalive/web",
    "start": "npm run start --workspace @mbtalive/proxy"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
