# Copy to .env in this directory. Node loads it natively; there is no dotenv.
#
# Without a key the MBTA API allows 20 requests/minute per IP. With one the limit
# is 1000/minute. Free and instant: https://api-v3.mbta.com/register
MBTA_API_KEY=

# Only needed if the browser and the proxy are on different origins, which is not
# the case on Vercel or in local development. Defaults to *.
# CORS_ORIGIN=https://your-app.vercel.app

# Standalone listener port. Render sets this automatically.
# PORT=8081
